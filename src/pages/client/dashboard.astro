---
import PortalLayout from '../../layouts/PortalLayout.astro';
import ClientDashboard from '../../components/portal/ClientDashboard';
import { getClientPortalSession } from '../../lib/server/session';

export const prerender = false;

const title = 'Client Portal Dashboard';

const activeSession = getClientPortalSession(Astro.cookies);
if (!activeSession) {
  return Astro.redirect('/client');
}
---

<PortalLayout title={title} description="Private client dashboard for project updates and milestone tracking.">
  <ClientDashboard client:load />
</PortalLayout>
