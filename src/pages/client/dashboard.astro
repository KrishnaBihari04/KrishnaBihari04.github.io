---
import PortalLayout from '../../layouts/PortalLayout.astro';
import ClientDashboard from '../../components/portal/ClientDashboard';
import { getProjectPortalSession } from '../../lib/server/session';

export const prerender = false;

const projectSession = getProjectPortalSession(Astro.cookies);

if (!projectSession) {
  return Astro.redirect('/client');
}
---

<PortalLayout title="Project Workspace">
  <ClientDashboard client:load />
</PortalLayout>