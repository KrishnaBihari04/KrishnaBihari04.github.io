---
import PortalLayout from '../../layouts/PortalLayout.astro';
import ClientLogin from '../../components/portal/ClientLogin';
import { getProjectPortalSession } from '../../lib/server/session';

export const prerender = false;

const projectSession = getProjectPortalSession(Astro.cookies);

if (projectSession) {
  return Astro.redirect('/client/dashboard');
}
---

<PortalLayout title="Project Portal">
  <ClientLogin client:load />
</PortalLayout>